                                <option>2 People (Couple)</option>
                                <option>3+ Family</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mt-8 text-center">
                        <button type="submit" class="w-full md:w-auto bg-brand-accent hover:bg-orange-600 text-white font-bold py-4 px-12 rounded-lg shadow-lg transition transform hover:-translate-y-1">
                            Confirm Registration
                        </button>
                        <p class="text-xs text-gray-500 mt-4">Your data is safe and will not be shared.</p>
                    </div>
                </form>

                <!-- Success Message (Hidden by default) -->
                <div id="successMessage" class="hidden text-center py-10">
                    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-check text-green-500 text-4xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800">Registration Successful!</h3>
                    <p class="text-gray-600 mt-2">Thanks for signing up. We've sent the details to your email.</p>
                    <button onclick="resetForm()" class="mt-6 text-brand font-bold underline">Register another person</button>

    <!-- Registration CTA -->
    <section id="register" class="py-20 bg-brand-dark text-white relative overflow-hidden">
        <!-- Decoration circles -->
        <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 rounded-full bg-white opacity-5"></div>
        <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-brand opacity-20"></div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-10">
                <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4">Reserve Your Spot</h2>
                <p class="text-brand-light text-lg">Space is limited to ensure a personalized experience. <br>Secure your participation today!</p>
            </div>

            <div class="bg-white rounded-2xl p-8 shadow-2xl text-gray-800">
                <form id="registrationForm" onsubmit="handleRegister(event)">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold mb-2 text-gray-700" for="name">Full Name</label>
                            <input class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition" id="name" type="text" placeholder="Your name" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2 text-gray-700" for="email">Email Address</label>
                            <input class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition" id="email" type="email" placeholder="example@email.com" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2 text-gray-700" for="phone">Phone Number</label>
                            <input class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition" id="phone" type="tel" placeholder="(555) 123-4567">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2 text-gray-700" for="attendees">Number of Attendees</label>
                            <select class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition" id="attendees">
